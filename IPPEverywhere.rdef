resource app_signature "application/x-vnd.ipp-everywhere";

resource app_flags B_SINGLE_LAUNCH;

resource app_version {
	major  = 0,
	middle = 1,
	minor  = 0,

	variety = B_APPV_ALPHA,
	internal = 0,

	short_info = "IPP Everywhere",
	long_info = "IPP Everywhere (PWG Raster) printer driver for Haiku"
};
